# =============================================================================
# EAP-AKA RADIUS PoC 環境変数設定
# =============================================================================
# 本ファイルを .env にコピーして値を設定してください。
# cp .env.example .env
#
# 必須は VALKEY_PASSWORD だけです。それ以外のオプション項目は、コメントアウトの
# ままにしておけば既定値で動きます（docker-compose.yml が ${変数:-既定値} の形で
# 渡すため、未設定と空の値は同じ扱いになります）。使わない項目はコメントアウトの
# まま触らないでください。
# コメント内の値には、既定値ではなく設定例のものがあります
# （VECTOR_GATEWAY_AKAONLY_URL / _CLIENT_CERT / _SERVER_CERT、COMPOSE_FILE 等）。
# コメント記号だけを外すと、その例の値が有効になるので注意してください。
# =============================================================================

# -----------------------------------------------------------------------------
# 認証情報（必須）
# -----------------------------------------------------------------------------
# Valkey (Redis) 接続パスワード
VALKEY_PASSWORD=your_secure_password_here

# -----------------------------------------------------------------------------
# RADIUS フォールバック共有シークレット（オプション）
# -----------------------------------------------------------------------------
# RADIUS の共有シークレットは、送信元IPごとに Admin TUI のクライアント登録
# （client:{IP}）で設定する。ここに値を設定すると、登録のない送信元IPからの
# パケットもこのシークレットで受け付ける（フォールバック）。
# インターネットに公開するサーバー（VPS 等）では空のままにすること。
# 空なら、登録のない送信元IPのパケットは破棄される（RADIUS_NO_SECRET）。
# 閉じた LAN で、AP の送信元IPを登録せずに試す場合にだけ設定する。
# RADIUS_SECRET=

# -----------------------------------------------------------------------------
# Vector Gateway設定（オプション）
# -----------------------------------------------------------------------------
# 動作モード: gateway（デフォルト）または passthrough
# VECTOR_GATEWAY_MODE=gateway

# PLMNマッピング（カンマ区切り）
# 形式: "PLMN:ID,PLMN:ID,..."
# 接続方式ID:
#   00   : 内部Vector API（デフォルト。マップに一致しないPLMNもこちら）
#   01   : aka-only-server（VECTOR_GATEWAY_AKAONLY_URL の設定が必要）
#   02-99: 将来実装（指定すると501）
# 例: VECTOR_GATEWAY_PLMN_MAP=44010:01
# VECTOR_GATEWAY_PLMN_MAP=

# 内部API呼び出しタイムアウト（デフォルト: 3s）
# auth-server の Vector Gateway 呼び出しタイムアウト（5秒）より短くすること。
# 同じか長いと、バックエンド障害時に auth-server が先にタイムアウトし、
# 502（VECTOR_API_ERR）ではなく接続エラー（VECTOR_CONN_ERR）として記録される
# VECTOR_GATEWAY_INTERNAL_TIMEOUT=3s

# -----------------------------------------------------------------------------
# aka-only-server 接続設定（接続方式ID:01、オプション）
# -----------------------------------------------------------------------------
# aka-only-server のベースURL。空なら 01 は無効（01 に向けたPLMNは501）
#   https://（既定・推奨）: mTLS で接続する。下記の証明書2つが必須
#   http://              : 平文HTTP（同一ホスト内に限る。CK/IKが暗号化されずに流れる）
# 同一ホスト（docker-compose.aka-av.yml を重ねる場合）:
#   https://aka-only-server:8443（平文なら http://aka-only-server:8080）
# VECTOR_GATEWAY_AKAONLY_URL=https://aka-only-server:8443

# クライアント証明書（`client gen-cert` の出力。証明書と秘密鍵が1ファイルでよい）
# deployments/certs/ に置き、コンテナ内の /certs/ のパスで指定する
# VECTOR_GATEWAY_AKAONLY_CLIENT_CERT=/certs/av-client.pem

# 秘密鍵（空なら CLIENT_CERT のファイルから読む）
# VECTOR_GATEWAY_AKAONLY_CLIENT_KEY=

# aka-only-server の AV 用サーバー証明書（`av-cert` の出力）。これだけを信頼する
# VECTOR_GATEWAY_AKAONLY_SERVER_CERT=/certs/av-server.pem

# aka-only-server 呼び出しタイムアウト（デフォルト: 3s。内部APIと同じ理由で5秒より短くすること）
# VECTOR_GATEWAY_AKAONLY_TIMEOUT=3s

# aka-only-server の compose が作る共有ネットワーク名（docker-compose.aka-av.yml 用）
# AKA_SHARED_NETWORK=aka-av

# 同一ホストで aka-only-server に接続する場合、オーバーレイを常に重ねるための指定。
# systemd など素の `docker compose up -d` でも docker-compose.aka-av.yml が適用される
# COMPOSE_FILE=docker-compose.yml:docker-compose.aka-av.yml

# -----------------------------------------------------------------------------
# Provisioning API 設定（オプション。D-13）
# -----------------------------------------------------------------------------
# 本PoCの外の BFF から、加入者・RADIUSクライアント・認可ポリシーを操作する REST API。
# profile に入っているため、`docker compose --profile provisioning up -d` で起動する
# （起動しない場合は以下の設定は不要）。
# サーバー証明書は deployments/certs/provisioning/ に server.pem / server.key として置く。
# 同じホストの BFF は、共有ネットワーク（下記 PROVISIONING_SHARED_NETWORK）に参加して
# https://provisioning-api:9444 で接続するため、証明書の SAN に DNS:provisioning-api を入れる。

# 管理クライアントの「識別名=クライアント証明書のSHA-256フィンガープリント」（カンマ区切り）。
# 空なら provisioning-api は起動しない。フィンガープリントは次で確認できる
# （コロン区切り・大文字のままでよい）:
#   openssl x509 -in client.pem -noout -fingerprint -sha256
# PROVISIONING_API_ADMIN_CLIENTS=bff-01=0123...cdef

# 9444/tcp を公開するアドレス（既定: 127.0.0.1 = 同じホストの BFF だけ）。
# 別ノードの BFF から使う場合は、受け付けるインターフェースのアドレス
# （WireGuard のアドレス等）または 0.0.0.0 にする
# PROVISIONING_API_BIND=127.0.0.1

# /status の nodeName に返すノードの識別名（既定: コンテナのホスト名 = コンテナID）
# PROVISIONING_API_NODE_NAME=

# 同じホストの BFF と共有する Docker ネットワークの名前（既定: eapaka-prov）。
# provisioning-api を起動したときに作られ、BFF 側は external として参加する
# PROVISIONING_SHARED_NETWORK=eapaka-prov

# -----------------------------------------------------------------------------
# ログ設定（オプション）
# -----------------------------------------------------------------------------
# ログレベル（DEBUG / INFO / WARN / ERROR。デフォルト: INFO）
# 対象: auth-server、acct-server、vector-gateway、vector-api、provisioning-api
# （provisioning-api の監査ログはログレベルによらず出力する）
# LOG_LEVEL=INFO

# IMSIマスキング有効化（デフォルト: true）
# - true : IMSI中央部分をマスク（440101********0）- 本番環境推奨
# - false: IMSI全桁表示（440101234567890）- デバッグ用
#
# 対象コンポーネント:
#   - auth-server
#   - acct-server
#   - vector-gateway
#   - vector-api
#   - provisioning-api（request completed のパス。監査ログの target_imsi は対象外で常に全桁）
#
# 注記: Admin TUIは対象外（常にIMSI全桁を表示/記録）
#       管理操作・監査証跡でIMSIを確実に識別できる運用を優先するため
#
# 注意: false設定はログファイルへのアクセス制御が適切に行われている
#       環境でのみ使用すること。調査完了後は速やかにtrueに戻すこと。
# LOG_MASK_IMSI=true

# -----------------------------------------------------------------------------
# テストベクターモード設定（開発・テスト環境専用）
# -----------------------------------------------------------------------------
# ※ 本番環境では以下の環境変数を設定しない、または明示的に false を指定すること
#
# テストベクターモードが有効な場合:
#   - 特定のIMSIプレフィックスに対して、Ki/OPc/AMF をテスト用固定値（3GPP TS 35.208 Test Set 1）に置き換えてベクターを計算
#   - 対象IMSIも Valkey への加入者登録（sub:{IMSI}）が必要（未登録なら 404。SQN は登録データで管理）
#   - セキュリティリスクがあるため、本番環境では絶対に有効にしないこと
#
# TEST_VECTOR_ENABLED=false
# TEST_VECTOR_IMSI_PREFIX=00101
